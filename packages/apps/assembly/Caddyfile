{
	admin off
	auto_https off
	persist_config off
}

:8080 {
	root * /srv
	encode zstd gzip

	handle /healthz {
		respond "ok" 200
	}

	# Hashed build assets: a missing one is a 404, never the SPA fallback, and
	# is not cached, since mid-rollout an old pod can miss a new asset.
	handle /assets/* {
		@exists file
		@missing not file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		header @missing Cache-Control "no-store"
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}
}
