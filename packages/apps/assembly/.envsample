# Which port should the dev service listen on? (defaults to port 3000)
VITE_PORT=3000

# ============================================================================
# Required EVE Frontier Configuration
# ============================================================================

# EVE World tier (dev | test | uat | ptu | live)
# Selects the @evefrontier/world-<package>-<tier> packages resolved through
# @evefrontier/wallet-core. Overrides the tier of the ?tenant= query param;
# only dev is registered so far.
VITE_EVE_WORLD_TIER="dev"

# ============================================================================
# Optional Configuration
# ============================================================================

# Change the following to the preferred world entity
# If defined, this will take priority over item IDs passed via URL query param
VITE_OBJECT_ID="0x08c7bf9636c37ecff92482a62340e5a1a2e8561da687a1c0a6e97758e67ae331"

# Set to "true" to render the internal feature-flag dev panel in this build.
# Leave unset for normal/production builds.
# VITE_SHOW_FLAG_PANEL="true"

# Dapp Index deployment for this environment (must include the scheme).
# Leave unset to keep each assembly's built-in view. The
# assembly-dapp-index-fallback flag can disable the fallback
# without unsetting this.
# VITE_DAPP_INDEX_URL="https://dev.dapp-index.evefrontier.com"
